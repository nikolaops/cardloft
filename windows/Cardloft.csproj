<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Targets .NET Framework 4.8, which ships with Windows 10 (1903+) and Windows 11,
    so users don't need to install a .NET runtime. The UI runs in Microsoft Edge WebView2.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Cardloft</AssemblyName>
    <RootNamespace>Cardloft</RootNamespace>
    <Product>Cardloft</Product>
    <Description>Offline kanban, sprint and backlog board</Description>
    <Copyright>Copyright (c) 2026 Nikola Stanković</Copyright>
    <Version>0.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

</Project>
